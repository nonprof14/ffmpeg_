# Research Layer Configuration
# Copy this file to .env and fill in your actual values

# n8n Instance
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook
N8N_API_KEY=your_n8n_api_key_here

# API Keys
PERPLEXITY_API_KEY=your_perplexity_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone Configuration
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=research-data
PINECONE_NAMESPACE=research-data

# Default Show Configuration
DEFAULT_SHOW_NAME=Breaking Bad
DEFAULT_WIKI_URL=https://breakingbad.fandom.com

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Rate Limiting
SCRAPER_DELAY_MS=1000
ENRICHMENT_DELAY_MS=2000
MAX_CONCURRENT_REQUESTS=5

# Logging
LOG_LEVEL=info
LOG_FILE=research-layer.log

# Testing
TEST_MODE=false
TEST_SHOW_NAME=Test Show
TEST_WIKI_URL=https://test.fandom.com
